# Copy to station.env, fill in, and put it on each card's boot partition
# after imaging. Never commit station.env to GitHub.

# remote MQTT server
MQTT_ADDRESS='mqtt.example.com:1883'
MQTT_USER='username'
MQTT_PASSWORD='password'

# web folder with nature and nature.service (no / at the end)
NATURE_URL='http://example.co.uk/install'
